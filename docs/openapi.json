{
  "openapi": "3.1.0",
  "info": {
    "title": "Seoul Bike Availability Dashboard API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Spring Boot backend"
    }
  ],
  "paths": {
    "/api/v1/llm/route-reasons": {
      "post": {
        "tags": ["llm"],
        "operationId": "explainRoutes",
        "summary": "Explain 1–3 ranked user routes",
        "requestBody": {"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RouteReasonsRequest"}}}},
        "security": [{},{"LlmToken":[]}],
        "responses": {"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RouteReasonsResponse"}}}},"401":{"description":"Token missing or rejected when auth is required"},"413":{"description":"Request body exceeds configured limit"},"429":{"description":"Rate limit exceeded"}}
      }
    },
    "/api/v1/llm/recommendation-reasons": {
      "post": {
        "tags": ["llm"],
        "operationId": "explainRecommendation",
        "summary": "Explain single-leg station recommendations",
        "requestBody": {"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LlmPayload"}}}},
        "security": [{},{"LlmToken":[]}],
        "responses": {"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LlmPayload"}}}},"401":{"description":"Token missing or rejected when auth is required"},"413":{"description":"Request body exceeds configured limit"},"429":{"description":"Rate limit exceeded"}}
      }
    },
    "/api/v1/llm/operator-copilot/briefing": {
      "post": {
        "tags": ["llm"],
        "operationId": "operatorCopilotBriefing",
        "summary": "Summarize the operator context",
        "requestBody": {"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/OperatorCopilotRequest"}}}},
        "security": [{},{"LlmToken":[]}],
        "responses": {"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LlmPayload"}}}},"401":{"description":"Token missing or rejected when auth is required"},"413":{"description":"Request body exceeds configured limit"},"429":{"description":"Rate limit exceeded"}}
      }
    },
    "/api/v1/llm/operator-copilot/diagnosis": {
      "post": {
        "tags": ["llm"],
        "operationId": "operatorCopilotDiagnosis",
        "summary": "Diagnose the operator context",
        "requestBody": {"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/OperatorCopilotRequest"}}}},
        "security": [{},{"LlmToken":[]}],
        "responses": {"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LlmPayload"}}}},"401":{"description":"Token missing or rejected when auth is required"},"413":{"description":"Request body exceeds configured limit"},"429":{"description":"Rate limit exceeded"}}
      }
    },
    "/api/v1/llm/operator-copilot/qa": {
      "post": {
        "tags": ["llm"],
        "operationId": "operatorCopilotQa",
        "summary": "Answer a question about the operator context",
        "requestBody": {"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/OperatorCopilotQuestion"}}}},
        "security": [{},{"LlmToken":[]}],
        "responses": {"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LlmPayload"}}}},"401":{"description":"Token missing or rejected when auth is required"},"413":{"description":"Request body exceeds configured limit"},"429":{"description":"Rate limit exceeded"}}
      }
    },
    "/api/v1/predict": {
      "post": {
        "tags": [ "prediction-controller" ],
        "operationId": "predict",
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PredictionRequest" } } },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/PredictionResponse" } } }
          }
        }
      }
    },
    "/api/v1/stations/status": {
      "get": {
        "tags": [ "station-status-controller" ],
        "operationId": "getStationStatuses",
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/StationStatusResponse" } } }
          }
        }
      }
    },
    "/api/v1/stations/nearby": {
      "get": {
        "tags": [ "nearby-station-controller" ],
        "operationId": "getNearbyStations",
        "parameters": [
          {
            "name": "latitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "longitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/NearbyStation" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/search/places": {
      "get": {
        "tags": [ "place-search-controller" ],
        "operationId": "searchPlaces",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/PlaceSearchResult" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/search/addresses": {
      "get": {
        "tags": [ "place-search-controller" ],
        "operationId": "searchAddresses",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/AddressSearchResult" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/routes": {
      "get": {
        "tags": [ "tmap-route-controller" ],
        "operationId": "getRoute",
        "summary": "Load the geometry of one route leg",
        "description": "Returns a TMAP pedestrian path when available, or a two-point straight-line fallback. The bike option changes the ETA estimate, using the same pedestrian geometry.",
        "parameters": [
          {
            "name": "startLat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "startLon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "endLat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "endLon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "bike",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "TMAP route or straight-line fallback (see method)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RouteResponse" } } }
          },
          "400": { "description": "Missing, malformed, or out-of-range coordinates" }
        }
      }
    },
    "/api/v1/routes/recommendations": {
      "get": {
        "tags": [ "route-recommendation-controller" ],
        "operationId": "recommendRoutes",
        "parameters": [
          {
            "name": "originLat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "originLon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "destinationLat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "destinationLon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/RouteRecommendationResponse" } } }
          }
        }
      }
    },
    "/api/v1/recommendations": {
      "get": {
        "tags": [ "recommendation-controller" ],
        "operationId": "getRecommendations",
        "parameters": [
          {
            "name": "leg",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "latitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "longitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "etaMin",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 5
            }
          },
          {
            "name": "topN",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 3
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/RecommendationResponse" } } }
          }
        }
      }
    },
    "/api/v1/operator/risk": {
      "get": {
        "tags": [ "operator-controller" ],
        "operationId": "getRisk",
        "parameters": [
          {
            "name": "basetime",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "horizon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "topn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/OperatorRiskResponse" } } }
          }
        }
      }
    },
    "/api/v1/operator/rebalancing": {
      "get": {
        "tags": [ "operator-controller" ],
        "operationId": "getRebalancing",
        "parameters": [
          {
            "name": "basetime",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "horizon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "topn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/RebalancingResponse" } } }
          }
        }
      }
    },
    "/api/v1/operator/briefing": {
      "get": {
        "tags": [ "operator-controller" ],
        "operationId": "getBriefing",
        "parameters": [
          {
            "name": "basetime",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "horizon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "topn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "type": "string" } } }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "LlmToken": { "type": "apiKey", "in": "header", "name": "X-LLM-Token" }
    },
    "schemas": {
      "LlmPayload": { "type": "object", "additionalProperties": true },
      "OperatorCopilotRequest": {
        "type": "object",
        "required": ["context"],
        "properties": { "context": { "$ref": "#/components/schemas/OperatorCopilotContext" } }
      },
      "OperatorCopilotQuestion": {
        "type": "object",
        "required": ["context", "question"],
        "properties": {
          "context": { "$ref": "#/components/schemas/OperatorCopilotContext" },
          "question": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      },
      "OperatorCopilotContext": {
        "type": "object",
        "required": ["base_time", "horizon_min"],
        "properties": {
          "base_time": { "type": "string" },
          "horizon_min": { "type": "integer", "minimum": 0 }
        }
      },
      "RouteReasonsRequest": {
        "type": "object",
        "required": ["routes"],
        "properties": {
          "routes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": { "$ref": "#/components/schemas/RouteReasonCandidate" }
          }
        }
      },
      "RouteReasonCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "origin_station_name", "destination_station_name", "walk_to_origin_min", "bike_min", "walk_to_destination_min", "total_eta_min", "origin_bikes_expected", "destination_docks_expected", "score"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
          "origin_station_name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "destination_station_name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "walk_to_origin_min": { "type": "integer", "minimum": 0 },
          "bike_min": { "type": "integer", "minimum": 0 },
          "walk_to_destination_min": { "type": "integer", "minimum": 0 },
          "total_eta_min": { "type": "integer", "minimum": 0 },
          "origin_bikes_expected": { "type": "number", "minimum": 0 },
          "destination_docks_expected": { "type": "number", "minimum": 0 },
          "score": { "type": "number" }
        }
      },
      "RouteReasonsResponse": {
        "type": "object",
        "required": ["reasons"],
        "properties": {
          "reasons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rank", "text"],
              "properties": {
                "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
                "text": { "type": "string", "minLength": 1, "maxLength": 300 }
              }
            }
          }
        }
      },
      "PredictionRequest": {
        "type": "object",
        "properties": {
          "horizons": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "request_id": { "type": "string" },
          "base_time": {
            "type": "string",
            "format": "date-time"
          },
          "station_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "HorizonResult": {
        "type": "object",
        "properties": {
          "horizon_min": {
            "type": "integer",
            "format": "int32"
          },
          "delta_net": {
            "type": "number",
            "format": "double"
          },
          "bikes_expected": {
            "type": "number",
            "format": "double"
          },
          "docks_expected": {
            "type": "number",
            "format": "double"
          },
          "prediction_source": { "type": "string" }
        }
      },
      "PredictionResponse": {
        "type": "object",
        "properties": {
          "predictions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/StationPrediction" }
          },
          "warnings": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PredictionWarning" }
          },
          "request_id": { "type": "string" },
          "base_time": {
            "type": "string",
            "format": "date-time"
          },
          "model_version": { "type": "string" }
        }
      },
      "PredictionWarning": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "station_id": { "type": "string" },
          "horizon_min": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "StationPrediction": {
        "type": "object",
        "properties": {
          "capacity": {
            "type": "integer",
            "format": "int32"
          },
          "station_id": { "type": "string" },
          "bikes_now": {
            "type": "integer",
            "format": "int32"
          },
          "inventory_source": { "type": "string" },
          "horizon_results": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/HorizonResult" }
          }
        }
      },
      "StationStatus": {
        "type": "object",
        "properties": {
          "station_id": { "type": "string" },
          "station_name": { "type": "string" },
          "district": { "type": "string" },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "capacity": {
            "type": "integer",
            "format": "int32"
          },
          "bikes_now": {
            "type": "integer",
            "format": "int32"
          },
          "docks_now": {
            "type": "integer",
            "format": "int32"
          },
          "collected_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "StationStatusResponse": {
        "type": "object",
        "properties": {
          "stations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/StationStatus" }
          }
        }
      },
      "NearbyStation": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "method": { "type": "string" },
          "station_id": { "type": "string" },
          "station_name": { "type": "string" },
          "distance_m": {
            "type": "number",
            "format": "double"
          },
          "walk_min": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "PlaceSearchResult": {
        "type": "object",
        "properties": {
          "placeName": { "type": "string" },
          "address": { "type": "string" },
          "roadAddress": { "type": "string" },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "AddressSearchResult": {
        "type": "object",
        "properties": {
          "address": { "type": "string" },
          "roadAddress": { "type": "string" },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "RouteCoordinate": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "RouteResponse": {
        "type": "object",
        "required": ["method", "path", "distance_m", "eta_min"],
        "properties": {
          "method": { "type": "string", "enum": ["route_api", "straight_line"] },
          "path": {
            "type": "array",
            "minItems": 2,
            "items": { "$ref": "#/components/schemas/RouteCoordinate" }
          },
          "distance_m": {
            "type": "number",
            "format": "double"
          },
          "eta_min": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Route": {
        "type": "object",
        "properties": {
          "rank": {
            "type": "integer",
            "format": "int32"
          },
          "origin_station_id": { "type": "string" },
          "origin_station_name": { "type": "string" },
          "destination_station_id": { "type": "string" },
          "destination_station_name": { "type": "string" },
          "walk_to_origin_min": {
            "type": "integer",
            "format": "int32"
          },
          "bike_min": {
            "type": "integer",
            "format": "int32"
          },
          "walk_to_destination_min": {
            "type": "integer",
            "format": "int32"
          },
          "total_eta_min": {
            "type": "integer",
            "format": "int32"
          },
          "score": {
            "type": "number",
            "format": "double"
          },
          "origin_latitude": {
            "type": "number",
            "format": "double"
          },
          "origin_longitude": {
            "type": "number",
            "format": "double"
          },
          "destination_latitude": {
            "type": "number",
            "format": "double"
          },
          "destination_longitude": {
            "type": "number",
            "format": "double"
          },
          "origin_bikes_now": {
            "type": "integer",
            "format": "int32"
          },
          "origin_bikes_expected": {
            "type": "number",
            "format": "double"
          },
          "destination_docks_now": {
            "type": "integer",
            "format": "int32"
          },
          "destination_docks_expected": {
            "type": "number",
            "format": "double"
          },
          "walk_to_origin_m": {
            "type": "number",
            "format": "double"
          },
          "walk_to_destination_m": {
            "type": "number",
            "format": "double"
          },
          "origin_eta_min": {
            "type": "integer",
            "format": "int32"
          },
          "destination_eta_min": {
            "type": "integer",
            "format": "int32"
          },
          "reason": { "type": "string" },
          "score_breakdown": { "type": "object", "additionalProperties": { "type": "number" } },
          "origin_prediction_source": { "type": ["string", "null"] },
          "destination_prediction_source": { "type": ["string", "null"] },
          "origin_inventory_collected_at": { "type": ["string", "null"], "format": "date-time" },
          "destination_inventory_collected_at": { "type": ["string", "null"], "format": "date-time" },
